#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>
#include <zephyr/dt-bindings/adc/adc.h>

/ {
    /* LDR on A0 (ADC1 channel 5) */
    zephyr,user {
        io-channels = <&adc1 5>;
    };

    /* RGB LED, common anode to 3.3 V: LOW = on
     * red D6, green D5, blue D3 */
    app_rgb_leds {
        compatible = "gpio-leds";
        rgb_red:   rgb_red   { gpios = <&arduino_header ARDUINO_HEADER_R3_D6 GPIO_ACTIVE_LOW>; };
        rgb_green: rgb_green { gpios = <&arduino_header ARDUINO_HEADER_R3_D5 GPIO_ACTIVE_LOW>; };
        rgb_blue:  rgb_blue  { gpios = <&arduino_header ARDUINO_HEADER_R3_D3 GPIO_ACTIVE_LOW>; };
    };

    /* short names used in the code */
    aliases {
        rgb-red = &rgb_red;       /* external RGB LED, red   -> D6 (470 ohm) */
        rgb-green = &rgb_green;   /* external RGB LED, green -> D5 (470 ohm) */
        rgb-blue = &rgb_blue;     /* external RGB LED, blue  -> D3 (470 ohm) */
        sw0 = &user_button_1;     /* button B1 */
        sensor-i2c = &i2c2;       /* MPU6050 + Si7021 */
        gps-uart = &usart1;       /* GPS */
    };
};

/* ADC for the LDR, 12 bits (0 - 4095) */
&adc1 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@5 {
        reg = <5>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};

/* I2C for MPU6050 (0x68) and Si7021 (0x40): SDA D14 (PA11), SCL D15 (PA12), 400 kHz */
&i2c2 {
    pinctrl-0 = <&i2c2_scl_pa12 &i2c2_sda_pa11>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_FAST>;
    status = "okay";
};

/* GPS on USART1, 9600 baud: board TX PB6 -> GPS RX, board RX PB7 -> GPS TX */
&usart1 {
    pinctrl-0 = <&usart1_tx_pb6 &usart1_rx_pb7>;
    pinctrl-names = "default";
    current-speed = <9600>;
    status = "okay";
};